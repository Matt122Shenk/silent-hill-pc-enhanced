    <!-- Embed the real pc_port/config.cfg so the launcher can regenerate a
         missing config.cfg with the full detailed template; the link keeps
         it in sync with the repo copy at build time. -->
    <EmbeddedResource Include="..\..\config.cfg">
      <Link>DefaultConfig.cfg</Link>
      <LogicalName>SilentHillPC_Launcher.DefaultConfig.cfg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
    <!-- Vendored unrar built as an x64 DLL (RAR4/RAR5/solid). Embedded in the exe
         so RarExtractor can materialize it to a temp path and LoadLibrary it — no
         dependency on the DLL being copied next to wherever the launcher runs. -->
    <EmbeddedResource Include="UnRAR.dll">
      <LogicalName>SilentHillPC_Launcher.UnRAR.dll</LogicalName>
    </EmbeddedResource>
    <!-- Standalone 7-Zip console tool (LGPL, (C) Igor Pavlov). Embedded in the exe
         so SevenZipExtractor can materialize it to a temp path and run it as a
         separate process to unpack .zip/.7z texture packs (every compression
         method, unlike miniz/.NET Store+Deflate). Its license ships as
         LICENSE-7zip.txt beside the launcher. -->
    <EmbeddedResource Include="7za.exe">
      <LogicalName>SilentHillPC_Launcher.7za.exe</LogicalName>
    </EmbeddedResource>
    <!-- Microsoft DirectXTex texconv (MIT). Embedded so DdsConverter can
         materialize it to a temp path and run it as a separate process for
         PNG<->BC7 .dds conversion — no managed-DLL load surface. Lives in
         pc_port/tools/ (referenced by relative path, flattened by LogicalName). -->
    <EmbeddedResource Include="..\..\tools\texconv.exe">
      <LogicalName>SilentHillPC_Launcher.texconv.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Include="Properties\Resources.Designer.cs">
