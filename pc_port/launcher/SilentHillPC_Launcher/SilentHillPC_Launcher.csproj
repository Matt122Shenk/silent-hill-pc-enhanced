         flows to the output folder next to the exe. -->
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <!-- Closure needed by the net4x build of the above (ReflectionOnly-verified);
         explicit References below because there is no VS target consuming the
         restore graph on this machine. -->
    <PackageReference Include="System.Memory" Version="4.5.5" PrivateAssets="All" />
    <PackageReference Include="System.Buffers" Version="4.5.1" PrivateAssets="All" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" PrivateAssets="All" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
